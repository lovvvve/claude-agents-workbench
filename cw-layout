#!/usr/bin/env python3
"""cw-layout —— cw 布局功能里和 tmux 打交道的部分。

  cw-layout save  --session SESS [--name NAME] [--yes] [--caller-pane %N]
      把工作台主窗口（含 @cw_role=left 的窗口）的当前布局存成模板
  cw-layout apply --session SESS --client TTY
      （由 cw 经 run-shell -b 调用）按主窗口的 @cw_apply 请求套用布局
  cw-layout menu  --session SESS [--running] [--current NAME]
      启动时的布局列表；stdout 只输出选中的值（__keep__ 或布局名）

纯逻辑在同目录的 cwlayout.py。
"""
import argparse
import fcntl
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import cwlayout  # noqa: E402
from cwlayout import leaves  # noqa: E402

SHELLS = ('sh', 'bash', 'zsh', 'fish', 'ksh', 'dash')


class CwError(Exception):
    """给用户看的中文错误；CLI 打到 stderr 并以退出码 1 结束。"""


# ---------------------------------------------------------------- tmux 与 /proc

def tmux(*args: str) -> str:
    return subprocess.run(['tmux', *args], capture_output=True, text=True,
                          check=True).stdout.rstrip('\n')


def main_window(sess: str) -> str:
    """工作台主窗口 = 含 @cw_role=left 的窗口；按整个会话找（-s），不受当前窗口影响。"""
    try:
        out = tmux('list-panes', '-s', '-t', '=' + sess, '-F', '#{window_id}\t#{@cw_role}')
    except subprocess.CalledProcessError:
        raise CwError('工作台 %s 未运行' % sess)
    for line in out.splitlines():
        wid, _, role = line.partition('\t')
        if role == 'left':
            return wid
    raise CwError('工作台 %s 里找不到 Agent View pane（@cw_role=left）' % sess)


def _stat_fields(pid: int) -> list:
    with open('/proc/%d/stat' % pid) as f:
        s = f.read()
    return s[s.rfind(')') + 2:].split()      # [state, ppid, pgrp, session, tty_nr, tpgid, ...]


def pane_fg_cmd(pane_pid: int) -> str:
    """pane 里 shell 的前台命令；shell 自己在前台（停在提示符）时返回 ''。"""
    try:
        f = _stat_fields(pane_pid)
        pgrp, tpgid = int(f[2]), int(f[5])
        if tpgid <= 0 or tpgid == pgrp:
            return ''
        with open('/proc/%d/cmdline' % tpgid, 'rb') as fh:
            argv = [a.decode('utf-8', 'replace') for a in fh.read().split(b'\0') if a]
        return cwlayout.argv_to_cmd(argv) if argv else ''
    except (OSError, ValueError, IndexError):
        return ''


def _panes(win: str) -> dict:
    out = tmux('list-panes', '-t', win, '-F', '#{pane_id}\t#{@cw_role}\t#{pane_pid}')
    info = {}
    for line in out.splitlines():
        pid_, role, ppid = line.split('\t')
        info[pid_] = (role, int(ppid))
    return info


def capture(sess: str, caller_pane: str = '') -> cwlayout.Node:
    """抓取主窗口布局：结构与比例取自 #{window_layout}，角色取自 @cw_role，命令取前台进程。"""
    win = main_window(sess)
    root = cwlayout.parse_tmux_layout(tmux('display', '-p', '-t', win, '#{window_layout}'))
    info = _panes(win)
    for leaf in leaves(root):
        role, ppid = info.get(leaf.pane_id, ('', 0))
        leaf.role = role if role in ('left', 'right') else 'extra'
        if leaf.role == 'extra':
            # 执行 cw -s 的那个 pane 前台是 cw 自己，记成空 shell
            leaf.cmd = '' if leaf.pane_id == caller_pane else pane_fg_cmd(ppid)
    return root


# ---------------------------------------------------------------- save

def _ask(prompt: str) -> str:
    sys.stdout.write(prompt)
    sys.stdout.flush()
    line = sys.stdin.readline()
    if not line:
        raise EOFError
    return line.rstrip('\n')


def cmd_save(a) -> int:
    root = capture(a.session, a.caller_pane or '')
    name = a.name
    if name is not None:
        err = cwlayout.validate_name(name)
        if err:
            raise CwError('布局名「%s」不合法：%s' % (name, err))
    while name is None:
        cand = _ask('布局名：').strip()
        err = cwlayout.validate_name(cand)
        if err:
            print(err)
            continue
        name = cand
    if not a.yes:
        extras = [l for l in leaves(root) if l.role == 'extra']
        for i, leaf in enumerate(extras, 1):
            print('[%d] %dx%d  命令：%s' % (i, leaf.w, leaf.h, leaf.cmd or '（空 shell）'))
            ans = _ask('回车保留 / 输入新命令 / 输入 - 清空：')
            if ans.strip() == '-':
                leaf.cmd = ''
            elif ans.strip():
                leaf.cmd = ans.strip()
        if name in cwlayout.list_layouts():
            if _ask('布局 %s 已存在，覆盖？[y/N] ' % name).strip().lower() not in ('y', 'yes'):
                print('已取消')
                return 1
    cwlayout.save_layout(name, root)
    tmux('set-option', '-w', '-t', main_window(a.session), '@cw_layout', name)
    print('已保存布局「%s」（%s）' % (name, os.path.join(cwlayout.config_dir(), 'layouts', name + '.json')))
    return 0


# ---------------------------------------------------------------- apply

PARKED_NAME = '保留'
MISMATCH_HINT = '当前 pane 与布局 %s 不一致，未调整；如需还原请在列表中重新选择'


def _lock(sess: str, timeout: float = 5.0):
    """与 cw 同一把锁：$XDG_RUNTIME_DIR/cw-<会话名>.lock。"""
    run = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
    fd = os.open(os.path.join(run, 'cw-%s.lock' % sess), os.O_WRONLY | os.O_CREAT, 0o600)
    end = time.time() + timeout
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.time() > end:
                os.close(fd)
                raise CwError('等待工作台锁超时（另一个 cw 正在运行？）')
            time.sleep(0.1)


def _notify(client: str, msg: str) -> None:
    args = ['display-message'] + (['-c', client] if client else []) + [msg.replace('#', '##')]
    try:
        tmux(*args)
    except subprocess.CalledProcessError:
        print(msg, file=sys.stderr)


def _wait(pred, timeout: float) -> bool:
    end = time.time() + timeout
    while time.time() < end:
        try:
            if pred():
                return True
        except subprocess.CalledProcessError:
            pass
        time.sleep(0.05)
    return False


def _idle(pane: str) -> bool:
    """停在 shell 提示符：前台是 shell，且就是 shell 自己（不是 bash deploy.sh 这类脚本）。

    只看 pane_current_command 不够：bash 脚本、cw 自己在前台时它也是 bash。
    """
    cmd, ppid = tmux('display', '-p', '-t', pane, '#{pane_current_command}\t#{pane_pid}').split('\t')
    return cmd in SHELLS and pane_fg_cmd(int(ppid)) == ''


def _window_size(win: str):
    w, h = tmux('display', '-p', '-t', win, '#{window_width} #{window_height}').split()
    return int(w), int(h)


def _pane_order(win: str) -> list:
    return tmux('list-panes', '-t', win, '-F', '#{pane_id}').split('\n')


def _order_panes(win: str, desired: list) -> None:
    """把窗口内 pane 顺序排成 desired：tmux 套自定义布局时按这个顺序填格子（忽略串里的编号）。"""
    for i, want in enumerate(desired):
        cur = _pane_order(win)
        if cur[i] != want:
            tmux('swap-pane', '-d', '-s', want, '-t', cur[i])


def _select_layout(win: str, target: cwlayout.Node, ids: list) -> None:
    _order_panes(win, ids)
    w, h = _window_size(win)
    tmux('select-layout', '-t', win,
         cwlayout.render_tmux_layout(target, w, h, [int(p.lstrip('%')) for p in ids]))


def _parked_window(sess: str) -> str:
    for line in tmux('list-windows', '-t', '=' + sess, '-F', '#{window_id}\t#{@cw_parked}').split('\n'):
        wid, _, flag = line.partition('\t')
        if flag == '1':
            return wid
    return ''


def _rescale(win: str, target: cwlayout.Node, name: str, client: str) -> bool:
    cur = cwlayout.parse_tmux_layout(tmux('display', '-p', '-t', win, '#{window_layout}'))
    info = _panes(win)
    for leaf in leaves(cur):
        leaf.role = info.get(leaf.pane_id, ('', 0))[0] or 'extra'
    if not cwlayout.same_shape(cur, target):
        _notify(client, MISMATCH_HINT % name)
        return False
    _select_layout(win, target, [l.pane_id for l in leaves(cur)])
    return True


def _reshape(sess: str, win: str, target: cwlayout.Node, client: str) -> bool:
    info = _panes(win)
    left = next((p for p, (r, _) in info.items() if r == 'left'), '')
    right = next((p for p, (r, _) in info.items() if r == 'right'), '')
    if not right:
        _notify(client, 'cw: 找不到跟随 shell pane（@cw_role=right），未套用布局')
        return False
    parked = _parked_window(sess)
    in_parked = set()
    cands = []
    for p in _pane_order(win):
        if p not in (left, right):
            cands.append(cwlayout.Candidate(p, pane_fg_cmd(info[p][1]), _idle(p)))
    if parked:
        for p, (_, ppid) in _panes(parked).items():
            cands.append(cwlayout.Candidate(p, pane_fg_cmd(ppid), _idle(p)))
            in_parked.add(p)
    asg = cwlayout.assign_panes(target, left, right, cands)

    def largest(where=win):
        best = max(tmux('list-panes', '-t', where, '-F', '#{pane_id} #{pane_width} #{pane_height}').split('\n'),
                   key=lambda l: int(l.split()[1]) * int(l.split()[2]))
        pid_, w, h = best.split()
        return pid_, int(w), int(h)

    # 用不上的挪进「保留」窗口（不杀）。每次先均分再挂到最大的 pane 上：
    # join-pane -d 默认总拆同一个 pane，对半几次就拆不动了
    for p in asg.park:
        if p in in_parked:
            continue
        if not parked:
            parked = tmux('break-pane', '-d', '-s', p, '-n', PARKED_NAME, '-P', '-F', '#{window_id}')
            tmux('set-option', '-w', '-t', parked, '@cw_parked', '1')
            tmux('set-option', '-w', '-t', parked, 'automatic-rename', 'off')
        else:
            tmux('select-layout', '-t', parked, 'tiled')
            tmux('join-pane', '-d', '-s', p, '-t', largest(parked)[0])
    if parked and asg.park:
        tmux('select-layout', '-t', parked, 'tiled')

    def split_new(home: str) -> str:
        """先均分再拆面积最大的 pane；按宽高比选方向（字符约 1:2），失败换另一个方向。"""
        tmux('select-layout', '-t', win, 'tiled')
        p, w, h = largest()
        dirs = ['-h', '-v'] if w >= 2 * h else ['-v', '-h']
        for d in dirs:
            try:
                return tmux('split-window', d, '-d', '-t', p, '-c', home, '-P', '-F', '#{pane_id}')
            except subprocess.CalledProcessError:
                continue
        raise CwError('窗口太小，无法再拆分 pane，布局未完整套用')

    # 被选中的、原本在「保留」里的拉回主窗口
    for p, _ in asg.slots:
        if p and p in in_parked:
            tmux('select-layout', '-t', win, 'tiled')
            tmux('join-pane', '-d', '-s', p, '-t', largest()[0])
    # 还缺的新开（在 ~）
    home = os.path.expanduser('~')
    ids, fresh = [], set()
    for p, _ in asg.slots:
        if p is None:
            try:
                p = split_new(home)
            except CwError as e:
                _notify(client, 'cw: %s' % e)
                return False
            fresh.add(p)
        ids.append(p)
    _select_layout(win, target, ids)

    # 只填命令、不回车；① 永远不会出现在这里
    for (p, need), leaf in zip(zip(ids, (n for _, n in asg.slots)), leaves(target)):
        if not need or p == left:
            continue
        _wait(lambda: _idle(p) and tmux('capture-pane', '-p', '-t', p).strip() != '', 5.0)
        if p not in fresh:
            tmux('send-keys', '-t', p, 'C-u')       # 复用的空 shell：先清掉行内残留再填
        _type_text(p, leaf.cmd)
    return True


def _type_text(pane: str, text: str) -> None:
    """原样把文本打进命令行，不回车。

    tmux 把以 ; 结尾的参数当成命令分隔符（以 \\; 结尾则还原成字面 ;），所以末尾的 ; 前要补一个 \\；
    -- 结束选项解析，以 - 开头的命令才不会被当成 send-keys 的参数。
    """
    if text.endswith(';'):
        text = text[:-1] + '\\;'
    tmux('send-keys', '-t', pane, '-l', '--', text)


def cmd_apply(a) -> int:
    fd = _lock(a.session)
    try:
        return _apply_locked(a)
    except subprocess.CalledProcessError as e:
        # 比如 apply 期间有 pane 被关掉：别让布局停在一半还没有任何提示
        detail = (e.stderr or '').strip() or ' '.join(e.cmd[1:2])
        msg = 'cw: 布局「%s」套用失败：%s' % (getattr(a, '_name', ''), detail)
        _notify(a.client, msg)
        print(msg, file=sys.stderr)
        return 1
    finally:
        os.close(fd)


def _apply_locked(a) -> int:
    win = main_window(a.session)
    req = tmux('show-options', '-wqv', '-t', win, '@cw_apply')
    tmux('set-option', '-wu', '-t', win, '@cw_apply')
    if not req:
        return 0
    mode, name, caller = (req.split('\t') + ['', '', ''])[:3]
    a._name = name                       # 出错提示用
    try:
        target = cwlayout.load_layout(name)
    except (OSError, ValueError) as e:
        msg = 'cw: 布局「%s」读取失败：%s' % (name, e)
        _notify(a.client, msg)
        print(msg, file=sys.stderr)
        return 1
    if a.client:   # 等窗口跟上这个客户端的尺寸（attach 后 resize 未必已生效）
        _wait(lambda: tmux('display', '-p', '-t', win, '#{window_width}') ==
              tmux('display', '-p', '-c', a.client, '#{client_width}'), 3.0)
    if caller:     # 执行 cw 的 pane 稍后才回到提示符
        _wait(lambda: _idle(caller), 1.5)
    ok = _rescale(win, target, name, a.client) if mode == 'rescale' else \
        _reshape(a.session, win, target, a.client)
    if ok:
        tmux('set-option', '-w', '-t', win, '@cw_layout', name)
    tmux('select-window', '-t', win)
    left = next((p for p, (r, _) in _panes(win).items() if r == 'left'), '')
    if left:
        tmux('select-pane', '-t', left)
    return 0 if ok or mode == 'rescale' else 1


# ---------------------------------------------------------------- menu

def detect_device():
    """(终端类型, 宽, 高)。tmux 内看当前客户端（shell 里的 LC_TERMINAL 可能来自别的设备）。"""
    if os.environ.get('TMUX'):
        try:
            raw = tmux('display', '-p', '#{client_termtype}')
            w, h = tmux('display', '-p', '#{client_width} #{client_height}').split()
            return cwlayout.normalize_term(raw), int(w), int(h)
        except (subprocess.CalledProcessError, ValueError):
            pass
    raw = os.environ.get('LC_TERMINAL', '')
    try:   # cw 用 $(…) 捕获 stdout，所以从 stderr 取尺寸，不能用 shutil.get_terminal_size()
        sz = os.get_terminal_size(sys.stderr.fileno())
        w, h = sz.columns, sz.lines
    except OSError:
        try:
            w, h = int(os.environ['COLUMNS']), int(os.environ['LINES'])
        except (KeyError, ValueError):
            w, h = 80, 24
    return cwlayout.normalize_term(raw), w, h


def cmd_menu(a) -> int:
    saved = cwlayout.list_layouts()
    if not saved:                      # 没存过布局：不弹列表，cw 照旧
        print(cwlayout.KEEP)
        return 0
    term, w, h = detect_device()
    default = cwlayout.pick_default(cwlayout.load_devices(), a.session, term, w, h,
                                    set(saved) | {cwlayout.BUILTIN_NAME},
                                    fallback=(a.current if a.running and a.current else cwlayout.BUILTIN_NAME))
    items = cwlayout.menu_items(saved, a.running, a.current or '')
    choice = default
    if sys.stdin.isatty():
        err = sys.stderr
        idx = next(i for i, (v, _) in enumerate(items, 1) if v == default)
        err.write('cw 布局（%s · %s %dx%d）：\n' % (a.session, term, w, h))
        for i, (v, text) in enumerate(items, 1):
            err.write('%s %d) %s\n' % ('*' if v == default else ' ', i, text))
        while True:
            err.write('选择 [%d]：' % idx)
            err.flush()
            line = sys.stdin.readline()
            if not line:
                raise EOFError
            choice = cwlayout.resolve_choice(line, items, default)
            if choice is not None:
                break
            err.write('无效的选择，请输入 1-%d 或直接回车\n' % len(items))
    if choice != cwlayout.KEEP:
        cwlayout.remember_device(cwlayout.DeviceRecord(a.session, term, w, h, choice))
    print(choice)
    return 0


# ---------------------------------------------------------------- 入口

def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog='cw-layout')
    sub = p.add_subparsers(dest='cmd', required=True)
    s = sub.add_parser('save')
    s.add_argument('--session', required=True)
    s.add_argument('--name')
    s.add_argument('--yes', action='store_true')
    s.add_argument('--caller-pane', default='')
    s = sub.add_parser('apply')
    s.add_argument('--session', required=True)
    s.add_argument('--client', default='')
    s = sub.add_parser('menu')
    s.add_argument('--session', required=True)
    s.add_argument('--running', action='store_true')
    s.add_argument('--current', default='')
    a = p.parse_args(argv)
    try:
        return {'save': cmd_save, 'apply': cmd_apply, 'menu': cmd_menu}[a.cmd](a)
    except CwError as e:
        print('cw: %s' % e, file=sys.stderr)
        return 1
    except (ValueError, OSError) as e:
        print('cw: %s' % e, file=sys.stderr)
        return 1
    except (EOFError, KeyboardInterrupt):
        print('', file=sys.stderr)
        return 130


if __name__ == '__main__':
    sys.exit(main())
